---
import AboutLayout from '@/shared/components/layout/AboutLayout.astro';
import ProjectHero from '@/shared/components/ui/ProjectHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projectDetails = await getCollection('projectDetails');
  return projectDetails.map((entry) => ({
    params: { slug: entry.id.replace(/\/about$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<AboutLayout
  title={`${entry.data.title} – Pabitra Mohan Singh`}
  projectName={entry.data.title}
  description={entry.data.description}
>
  <div class="project-page">
    <ProjectHero
      category={entry.data.category}
      title={entry.data.title}
      description={entry.data.description}
      role={entry.data.role}
      status={entry.data.status}
      year={entry.data.year}
      techStack={entry.data.techStack}
      liveUrl={entry.data.liveUrl}
      sourceUrl={entry.data.githubUrl}
    />

    <div class="project-page-content">
      <Content />
    </div>
  </div>
</AboutLayout>

<style>
  .project-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 120px;
  }

  .project-page-content {
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .project-page {
      padding: 24px 20px 80px;
    }
  }
</style>