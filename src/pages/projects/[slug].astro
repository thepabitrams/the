---
import { ProjectLayout } from '@/layouts/';
import ProjectHero from '@/shared/components/ProjectHero.astro';
import Accordion from '@/shared/components/Accordion.astro';
import GitHubActivity from '@/shared/components/GitHubActivity.astro';
import { getCollection, render } from 'astro:content';
import { site } from '@/shared/config/site';
import {
  fetchRepoActivity,
  parseGitHubUrl,
  type GitHubEvent,
} from '@/shared/lib/github';

export async function getStaticPaths() {
  const projectDetails = await getCollection('projectDetails');
  return projectDetails.map((entry) => ({
    params: { slug: entry.id.replace(/\/about$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { githubUrl } = entry.data;
const projectSlug = entry.id.replace(/\/about$/, '');

const finalSeoTitle = entry.data.seoTitle || `${entry.data.title} | Pabitra Mohan Singh`;
const finalSeoDescription = entry.data.seoDescription || entry.data.description;

const breadcrumbItems = [
  { name: 'Home', url: site.domain },
  { name: 'Projects', url: `${site.domain}/projects` },
  { name: entry.data.title, url: `${site.domain}/projects/${projectSlug}` }
];

let activity: GitHubEvent[] = [];
if (githubUrl) {
  const parsed = parseGitHubUrl(githubUrl);
  if (parsed) {
    activity = await fetchRepoActivity(parsed.owner, parsed.repo, 5);
  }
}
---

<ProjectLayout
  title={finalSeoTitle}
  projectName={entry.data.title}
  description={finalSeoDescription}
  breadcrumbItems={breadcrumbItems}
>
  <div class="project-page">
    <ProjectHero
      category={entry.data.category}
      title={entry.data.title}
      description={entry.data.description}
      role={entry.data.role}
      status={entry.data.status}
      year={entry.data.year}
      techStack={entry.data.techStack}
      liveUrl={entry.data.liveUrl}
      sourceUrl={entry.data.githubUrl}
    />

    <div class="project-page-content">
      <Content />

      {activity.length > 0 && (
        <Accordion title="GitHub Recent Activity">
          <GitHubActivity events={activity} />
        </Accordion>
      )}
    </div>
  </div>
</ProjectLayout>

<style>
  .project-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 120px;
  }

  .project-page-content {
    margin-top: 32px;
  }

  @media (max-width: 640px) {
    .project-page {
      padding: 24px 20px 80px;
    }
  }
</style>