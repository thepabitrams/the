---
import SponsorLayout from '@/layouts/Sponsor.astro';
import { ParticleAvatar } from '@/shared/components/avatar';

const githubSponsorsUrl = 'https://github.com/sponsors/thepabitrams';
const buyMeACoffeeUrl = 'https://buymeacoffee.com/thepabitrams';

const myLightImages = [
  '/icons/pabitra-avatar-black.svg',
  '/icons/pabitra-avatar-suit-black.svg'
]; 

const myDarkImages = [
  '/icons/pabitra-avatar-white.svg',
  '/icons/pabitra-avatar-suit-white.svg'
];
---

<SponsorLayout 
  title="Sponsor My Work — Pabitra Mohan Singh" 
  description="Sponsor my open-source work via GitHub or Buy Me a Coffee."
>
  <div class="w-full max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-center flex-1 gap-8 md:gap-20 py-12 relative z-10 pointer-events-none">
    
    <ParticleAvatar 
      lightImages={myLightImages} 
      darkImages={myDarkImages} 
      class="w-full md:w-1/2 h-80 md:h-125" 
    />

    <div class="w-full md:w-1/2 max-w-md flex flex-col gap-8 pointer-events-auto mt-4 md:mt-0">
      
      <div class="text-center md:text-left">
        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white mb-4">
          Sponsor My Work
        </h1>
        <p class="text-base text-neutral-500 dark:text-neutral-400 leading-relaxed">
          If my open-source code or writing saved you time, consider buying me a coffee or sponsoring the servers. Every bit helps.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        
        <a 
          href={githubSponsorsUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group flex items-center justify-between p-5 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl hover:shadow-lg hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-neutral-900 dark:text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.62.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </div>
            <div class="text-left">
              <h2 class="font-bold text-neutral-900 dark:text-white">GitHub Sponsors</h2>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">Recurring support</p>
            </div>
          </div>
        </a>

        <a 
          href={buyMeACoffeeUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group flex items-center justify-between p-5 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl hover:shadow-lg hover:border-neutral-300 dark:hover:border-neutral-700 transition-all duration-300"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-[#FFDD00]/10 dark:bg-[#FFDD00]/20 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-[#FFDD00]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z" />
              </svg>
            </div>
            <div class="text-left">
              <h2 class="font-bold text-neutral-900 dark:text-white">Buy Me a Coffee</h2>
              <p class="text-sm text-neutral-500 dark:text-neutral-400">One-off tip</p>
            </div>
          </div>
        </a>

      </div>
    </div>

  </div>
</SponsorLayout>