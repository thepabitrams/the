<div class="data-flow-graph">
  <svg 
    class="data-flow-graph__canvas" 
    viewBox="0 0 800 600" 
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Full stack data flow from User to Database and back"
  >
    <defs>
      <marker id="data-flow-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 1 L7 4 L0 7 Z" fill="var(--md-comp-data-flow-arrow-color)" />
      </marker>
      <marker id="data-flow-arrow-arch" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 1 L7 4 L0 7 Z" fill="var(--md-comp-data-flow-arrow-color)" />
      </marker>
    </defs>

    <rect class="data-flow-graph__node data-flow-graph__node--filled" x="250" y="40" width="300" height="50" rx="8" />
    <text class="data-flow-graph__title" x="400" y="70">User</text>

    <rect class="data-flow-graph__node" x="200" y="160" width="400" height="70" rx="10" />
    <text class="data-flow-graph__title" x="400" y="195">React App</text>
    <text class="data-flow-graph__body" x="400" y="215">Vite + Tailwind</text>

    <rect class="data-flow-graph__node" x="200" y="300" width="400" height="70" rx="10" />
    <text class="data-flow-graph__title" x="400" y="335">Hono API</text>
    <text class="data-flow-graph__body" x="400" y="355">Cloudflare Worker</text>

    <rect class="data-flow-graph__node data-flow-graph__node--filled" x="200" y="440" width="400" height="70" rx="10" />
    <text class="data-flow-graph__title" x="400" y="475">Cloudflare D1</text>
    <text class="data-flow-graph__body" x="400" y="495">Drizzle ORM</text>

    <path class="data-flow-graph__arrow" d="M330 90 L330 160" marker-end="url(#data-flow-arrow)" />
    <path class="data-flow-graph__arrow" d="M330 230 L330 300" marker-end="url(#data-flow-arrow)" />
    <path class="data-flow-graph__arrow" d="M330 370 L330 440" marker-end="url(#data-flow-arrow)" />

    <path class="data-flow-graph__arrow" d="M470 440 L470 370" marker-end="url(#data-flow-arrow)" />

    <path class="data-flow-graph__arrow-arch" d="M 600 335 C 700 335, 700 65, 550 65" marker-end="url(#data-flow-arrow-arch)" />

    <text class="data-flow-graph__label" x="315" y="125" text-anchor="end">Form Data</text>
    <text class="data-flow-graph__label" x="315" y="265" text-anchor="end">POST /letters</text>
    <text class="data-flow-graph__label" x="315" y="405" text-anchor="end">SQL Query</text>

    <text class="data-flow-graph__label" x="485" y="405" text-anchor="start">DB Result</text>

    <text class="data-flow-graph__label" x="720" y="195" text-anchor="start">JSON Response</text>
    <text class="data-flow-graph__label" x="720" y="215" text-anchor="start">(Rendered Data)</text>

    <path class="data-flow-graph__pulse data-flow-graph__pulse--req-1" pathLength="100" d="M330 90 L330 160" />
    <path class="data-flow-graph__pulse data-flow-graph__pulse--req-2" pathLength="100" d="M330 230 L330 300" />
    <path class="data-flow-graph__pulse data-flow-graph__pulse--req-3" pathLength="100" d="M330 370 L330 440" />
    
    <path class="data-flow-graph__pulse data-flow-graph__pulse--res-up" pathLength="100" d="M470 440 L470 370" />
    <path class="data-flow-graph__pulse data-flow-graph__pulse--res-arch" pathLength="100" d="M 600 335 C 700 335, 700 65, 550 65" />
  </svg>
</div>

<style is:global>
  :root {
    --md-sys-color-surface: #FFFFFF;
    --md-sys-color-surface-container: #F8F9FA;
    --md-sys-color-on-surface: #1A1A1A;
    --md-sys-color-on-surface-variant: #555555;
    --md-sys-color-outline: #C4C4C4;
    --md-sys-color-outline-variant: #999999;

    --md-sys-typescale-title-medium-size: 18px;
    --md-sys-typescale-title-medium-weight: 700;
    --md-sys-typescale-body-medium-size: 14px;
    --md-sys-typescale-body-medium-weight: 500;
    --md-sys-typescale-label-medium-size: 12px;
    --md-sys-typescale-label-medium-weight: 700;
  }

  .dark {
    --md-sys-color-surface: #0F0F0F;
    --md-sys-color-surface-container: #050505;
    --md-sys-color-on-surface: #F0F0F0;
    --md-sys-color-on-surface-variant: #A0A0A0;
    --md-sys-color-outline: #3A3A3A;
    --md-sys-color-outline-variant: #666666;
  }

  .data-flow-graph {
    --md-comp-data-flow-container-color: var(--md-sys-color-surface);
    --md-comp-data-flow-container-color-alt: var(--md-sys-color-surface-container);
    --md-comp-data-flow-outline-color: var(--md-sys-color-on-surface);
    --md-comp-data-flow-arrow-color: var(--md-sys-color-outline);
    --md-comp-data-flow-pulse-color: var(--md-sys-color-on-surface);
    --md-comp-data-flow-title-color: var(--md-sys-color-on-surface);
    --md-comp-data-flow-body-color: var(--md-sys-color-on-surface-variant);
    --md-comp-data-flow-label-color: var(--md-sys-color-on-surface-variant);
    
    --md-comp-data-flow-outline-width: 2px;
    --md-comp-data-flow-pulse-width: 4px;

    width: 100%;
    display: flex;
    justify-content: center;
    margin: 32px 0;
  }

  .data-flow-graph .data-flow-graph__canvas {
    width: 100%;
    max-width: 800px;
    height: auto;
    display: block;
    overflow: visible;
  }

  .data-flow-graph .data-flow-graph__node {
    fill: var(--md-comp-data-flow-container-color);
    stroke: var(--md-comp-data-flow-outline-color);
    stroke-width: var(--md-comp-data-flow-outline-width);
    vector-effect: non-scaling-stroke;
  }

  .data-flow-graph .data-flow-graph__node--filled {
    fill: var(--md-comp-data-flow-container-color-alt);
  }

  .data-flow-graph .data-flow-graph__arrow {
    fill: none;
    stroke: var(--md-comp-data-flow-arrow-color);
    stroke-width: var(--md-comp-data-flow-outline-width);
    vector-effect: non-scaling-stroke;
  }

  .data-flow-graph .data-flow-graph__arrow-arch {
    fill: none;
    stroke: var(--md-comp-data-flow-arrow-color);
    stroke-width: var(--md-comp-data-flow-outline-width);
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  .data-flow-graph .data-flow-graph__title {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    fill: var(--md-comp-data-flow-title-color);
    text-anchor: middle;
  }

  .data-flow-graph .data-flow-graph__body {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--md-sys-typescale-body-medium-size);
    font-weight: var(--md-sys-typescale-body-medium-weight);
    fill: var(--md-comp-data-flow-body-color);
    text-anchor: middle;
  }

  .data-flow-graph .data-flow-graph__label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--md-sys-typescale-label-medium-size);
    font-weight: var(--md-sys-typescale-label-medium-weight);
    fill: var(--md-comp-data-flow-label-color);
  }

  .data-flow-graph .data-flow-graph__pulse {
    stroke: var(--md-comp-data-flow-pulse-color);
    stroke-width: var(--md-comp-data-flow-pulse-width);
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 20 1000;
    stroke-dashoffset: 20;
    opacity: 0;
    animation: data-flow-pulse-anim 4s linear infinite;
  }

  .data-flow-graph .data-flow-graph__pulse--req-1 { animation-delay: 0s; }
  .data-flow-graph .data-flow-graph__pulse--req-2 { animation-delay: 0.5s; }
  .data-flow-graph .data-flow-graph__pulse--req-3 { animation-delay: 1.0s; }
  .data-flow-graph .data-flow-graph__pulse--res-up { animation-delay: 1.5s; }
  .data-flow-graph .data-flow-graph__pulse--res-arch { animation-delay: 2.0s; }

  @keyframes data-flow-pulse-anim {
    0%, 10%   { stroke-dashoffset: 100; opacity: 0; }
    15%       { opacity: 1; }
    35%, 100% { stroke-dashoffset: -100; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .data-flow-graph .data-flow-graph__pulse {
      animation: none !important;
      opacity: 0;
    }
  }
</style>