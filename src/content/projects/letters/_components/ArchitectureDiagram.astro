<div class="architecture-diagram">
  <svg class="architecture-diagram__canvas" viewBox="0 0 900 240" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="architecture-arrowhead" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0 1 L7 4 L0 7 Z" fill="var(--arch-color-connector)" />
      </marker>
    </defs>

    <rect class="architecture-diagram__node" x="370" y="8" width="160" height="56" rx="10" />
    <text class="architecture-diagram__title--root" x="450" y="43" text-anchor="middle">src/</text>

    <path class="architecture-diagram__edge" d="M450 64 L450 100" />
    <path class="architecture-diagram__edge" d="M120 100 L780 100" />

    <path class="architecture-diagram__edge" d="M120 100 L120 132" marker-end="url(#architecture-arrowhead)" />
    <path class="architecture-diagram__edge" d="M340 100 L340 132" marker-end="url(#architecture-arrowhead)" />
    <path class="architecture-diagram__edge" d="M560 100 L560 132" marker-end="url(#architecture-arrowhead)" />
    <path class="architecture-diagram__edge" d="M780 100 L780 132" marker-end="url(#architecture-arrowhead)" />

    <rect class="architecture-diagram__node--filled" x="55" y="138" width="130" height="64" rx="10" />
    <text class="architecture-diagram__title--folder" x="120" y="176" text-anchor="middle">pages/</text>

    <rect class="architecture-diagram__node--filled" x="275" y="138" width="130" height="64" rx="10" />
    <text class="architecture-diagram__title--folder" x="340" y="176" text-anchor="middle">letter/</text>

    <rect class="architecture-diagram__node--filled" x="495" y="138" width="130" height="64" rx="10" />
    <text class="architecture-diagram__title--folder" x="560" y="176" text-anchor="middle">core/</text>

    <rect class="architecture-diagram__node--filled" x="715" y="138" width="130" height="64" rx="10" />
    <text class="architecture-diagram__title--folder" x="780" y="176" text-anchor="middle">db/</text>

    <path class="architecture-diagram__edge" d="M190 170 L265 170" marker-end="url(#architecture-arrowhead)" />
    <path class="architecture-diagram__edge" d="M410 170 L485 170" marker-end="url(#architecture-arrowhead)" />
    <path class="architecture-diagram__edge" d="M630 170 L705 170" marker-end="url(#architecture-arrowhead)" />

    <path class="architecture-diagram__pulse architecture-diagram__pulse--pages"           pathLength="100" d="M450 64 L450 100 L120 100 L120 138" />
    <path class="architecture-diagram__pulse architecture-diagram__pulse--letter"          pathLength="100" d="M450 64 L450 100 L340 100 L340 138" />
    <path class="architecture-diagram__pulse architecture-diagram__pulse--core"            pathLength="100" d="M450 64 L450 100 L560 100 L560 138" />
    <path class="architecture-diagram__pulse architecture-diagram__pulse--db"              pathLength="100" d="M450 64 L450 100 L780 100 L780 138" />

    <path class="architecture-diagram__pulse architecture-diagram__pulse--pages-to-letter" pathLength="100" d="M190 170 L265 170" />
    <path class="architecture-diagram__pulse architecture-diagram__pulse--letter-to-core"  pathLength="100" d="M410 170 L485 170" />
    <path class="architecture-diagram__pulse architecture-diagram__pulse--core-to-db"      pathLength="100" d="M630 170 L705 170" />
  </svg>
</div>

<style is:global>
  .architecture-diagram {
    --arch-color-surface: #FFFFFF;
    --arch-color-surface-variant: #F1F3F4;
    --arch-color-connector: #B0B8C0;
    --arch-color-on-surface: #202124;

    --arch-stroke-width: 1.3px;
    --arch-stroke-width-connector: 1.2px;
    --arch-stroke-width-pulse: 2.6px;
    --arch-font-size-root: 20px;
    --arch-font-size-folder: 18px;
    --arch-font-weight: 600;

    --arch-motion-duration: 5s;
    --arch-motion-easing: ease-in-out;
    --arch-motion-delay: 1s;

    width: 100%;
    display: flex;
    justify-content: center;
    margin: 24px 0;
  }

  .dark .architecture-diagram {
    --arch-color-surface: #141414;
    --arch-color-surface-variant: #1E1E1E;
    --arch-color-connector: #555555;
    --arch-color-on-surface: #F0F0F0;
  }

  .architecture-diagram .architecture-diagram__canvas {
    width: 100%;
    max-width: 900px;
    height: auto;
    display: block;
  }

  .architecture-diagram .architecture-diagram__edge {
    fill: none;
    stroke: var(--arch-color-connector);
    stroke-width: var(--arch-stroke-width-connector);
    vector-effect: non-scaling-stroke;
  }

  .architecture-diagram .architecture-diagram__node,
  .architecture-diagram .architecture-diagram__node--filled {
    stroke: var(--arch-color-on-surface);
    stroke-width: var(--arch-stroke-width);
    vector-effect: non-scaling-stroke;
  }

  .architecture-diagram .architecture-diagram__node          { fill: var(--arch-color-surface); }
  .architecture-diagram .architecture-diagram__node--filled { fill: var(--arch-color-surface-variant); }

  .architecture-diagram .architecture-diagram__title--root,
  .architecture-diagram .architecture-diagram__title--folder {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: var(--arch-font-weight);
    fill: var(--arch-color-on-surface);
  }

  .architecture-diagram .architecture-diagram__title--root   { font-size: var(--arch-font-size-root); }
  .architecture-diagram .architecture-diagram__title--folder { font-size: var(--arch-font-size-folder); }

  .architecture-diagram .architecture-diagram__pulse {
    stroke: var(--arch-color-on-surface);
    stroke-width: var(--arch-stroke-width-pulse);
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 20 1000;
    stroke-dashoffset: 20;
    opacity: 0;
    animation: architecture-pulse-run var(--arch-motion-duration) var(--arch-motion-easing) infinite;
  }

  .architecture-diagram .architecture-diagram__pulse--pages           { animation-delay: 0s; }
  .architecture-diagram .architecture-diagram__pulse--pages-to-letter { animation-delay: var(--arch-motion-delay); }
  .architecture-diagram .architecture-diagram__pulse--letter          { animation-delay: var(--arch-motion-delay); }
  .architecture-diagram .architecture-diagram__pulse--letter-to-core  { animation-delay: calc(var(--arch-motion-delay) * 2); }
  .architecture-diagram .architecture-diagram__pulse--core            { animation-delay: calc(var(--arch-motion-delay) * 2); }
  .architecture-diagram .architecture-diagram__pulse--core-to-db      { animation-delay: calc(var(--arch-motion-delay) * 3); }
  .architecture-diagram .architecture-diagram__pulse--db              { animation-delay: calc(var(--arch-motion-delay) * 3); }

  @keyframes architecture-pulse-run {
    0%   { stroke-dashoffset: 20; opacity: 0; }
    3%   { opacity: 1; }
    17%  { stroke-dashoffset: -80; opacity: 1; }
    20%  { stroke-dashoffset: -80; opacity: 0; }
    25%  { stroke-dashoffset: 20; opacity: 0; }
    100% { stroke-dashoffset: 20; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .architecture-diagram .architecture-diagram__pulse {
      animation: none !important;
      opacity: 0;
    }
  }
</style>