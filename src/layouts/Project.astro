---
import Base from './Base.astro';
import { HomeHeader } from '@/shared/components/header';
import { ProjectFooter } from '@/shared/components/footer';
import type { BreadcrumbItem } from '@/shared/seo/Head.astro';

export interface Props {
  title: string;
  description?: string;
  projectName?: string;
  backHref?: string;
  backLabel?: string;
  breadcrumbItems?: readonly BreadcrumbItem[];
}

const {
  title,
  description,
  projectName = title,
  backHref = '/projects',
  backLabel = 'Back to Projects',
  breadcrumbItems = [],
} = Astro.props;
---

<Base {title} {description} {breadcrumbItems}>
  <HomeHeader {projectName} {backHref} {backLabel} />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <ProjectFooter />
</Base>