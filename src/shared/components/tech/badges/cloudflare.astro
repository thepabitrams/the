---
import { BADGE_WRAPPER, BADGE_LABEL, BADGE_VERSION } from '../badgeStyles';
import type { BadgeProps } from '../types';

const { version, class: className = '' } = Astro.props;
---
<a
  href="https://workers.cloudflare.com"
  target="_blank"
  rel="noopener noreferrer"
  class:list={[BADGE_WRAPPER, className]}
  aria-label="Cloudflare Workers"
>
  <span class={BADGE_LABEL}>
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="m8.213.063 8.879 12.136-8.67 11.739h2.476l8.665-11.735-8.89-12.14Zm4.728 0 9.02 11.992-9.018 11.883h2.496L24 12.656v-1.199L15.434.063ZM7.178 2.02.01 11.398l-.01 1.2 7.203 9.644 1.238-1.676-6.396-8.556 6.361-8.313Z"/>
    </svg>
    Cloudflare Workers
  </span>
  {version && (
    <span class:list={[BADGE_VERSION]} style="background-color: #F38020; color: #fff;">
      {version}
    </span>
  )}
</a>