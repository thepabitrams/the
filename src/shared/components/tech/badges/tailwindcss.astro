---
import { BADGE_WRAPPER, BADGE_LABEL, BADGE_VERSION } from '../badgeStyles';
import type { BadgeProps } from '../types';

const { version, class: className = '' } = Astro.props;
---
<a
  href="https://tailwindcss.com"
  target="_blank"
  rel="noopener noreferrer"
  class:list={[BADGE_WRAPPER, className]}
  aria-label="Tailwind CSS"
>
  <span class={BADGE_LABEL}>
    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z"/>
    </svg>
    Tailwind
  </span>
  {version && (
    <span class:list={[BADGE_VERSION]} style="background-color: #06B6D4; color: #fff;">
      {version}
    </span>
  )}
</a>