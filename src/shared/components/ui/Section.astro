---
export interface Props {
  title: string;
  class?: string;
}
const { title, class: className = '' } = Astro.props;
---

<div class={`mb-6 ${className}`}>
  <div class="bg-white dark:bg-neutral-900 rounded-t-xl px-6 py-5 border-b border-neutral-200 dark:border-neutral-700">
    <h2 class="text-xl font-medium text-neutral-900 dark:text-white tracking-tight">
      {title}
    </h2>
  </div>

  <div class="bg-neutral-50 dark:bg-neutral-800/50 rounded-b-xl px-6 py-5">
    <slot />
  </div>
</div>