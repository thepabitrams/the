---
import type { BreadcrumbItem } from '@/shared/seo/Head.astro';

export interface Props {
  items: readonly BreadcrumbItem[];
}

const { items } = Astro.props;
---

{items.length >= 2 && (
  <nav aria-label="Breadcrumb" class="mb-6">
    <ol class="flex items-center flex-wrap gap-2 text-sm">
      {items.map((breadcrumbItem, index) => {
        const isFinalItem = index === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {isFinalItem ? (
              <span
                aria-current="page"
                class="font-medium text-neutral-900 dark:text-white"
              >
                {breadcrumbItem.name}
              </span>
            ) : (
              <a
                href={breadcrumbItem.url}
                class="text-neutral-500 dark:text-neutral-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                {breadcrumbItem.name}
              </a>
            )}
            {!isFinalItem && (
              <span
                aria-hidden="true"
                class="text-neutral-300 dark:text-neutral-600"
              >
                /
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}