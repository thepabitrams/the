---
import Socials from '@/_pages/home/ui/Socials.astro';

const currentYear = new Date().getFullYear();
const legalLinks = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Service' },
];
---

<footer class="border-t border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-950">
  <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
    
    <!-- THE 3-COLUMN GRID -->
    <div class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto] gap-10 md:gap-12 items-start">
      
      <!-- COLUMN 1: The Image -->
      <div class="flex justify-center md:justify-start">
        <img 
          src="/profile/pabitra-avatar-suit-black.svg" 
          alt="Pabitra Mohan Singh" 
          width="128" 
          height="128" 
          class="size-32 shrink-0 dark:hidden" 
        />
        <img 
          src="/profile/pabitra-avatar-suit-white.svg" 
          alt="Pabitra Mohan Singh" 
          width="128" 
          height="128" 
          class="hidden size-32 shrink-0 dark:block" 
        />
      </div>

      <!-- COLUMN 2: Name, Bio, Socials -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left gap-2">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">
          Pabitra Mohan Singh
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-sm">
          Building clean, scalable, and user-focused applications. Always learning and improving as a developer.
        </p>
        
        <div class="mt-2">
          <Socials />
        </div>
      </div>

      <!-- COLUMN 3: Support Block -->
      <div class="flex flex-col items-center md:items-end text-center md:text-right gap-3 max-w-xs mx-auto md:mx-0">
        <h3 class="font-semibold text-sm text-neutral-900 dark:text-white uppercase tracking-wider">
          Support
        </h3>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          Love my work? You can buy me a coffee or sponsor my open-source projects.
        </p>
        <a 
          href="/support" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white dark:bg-neutral-900 border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-50 dark:hover:bg-neutral-800 text-sm font-semibold rounded-full transition-all shadow-sm w-full md:w-auto mt-2 group"
        >
          <svg class="w-4 h-4 text-blue-600 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          Support My Work
        </a>
      </div>

    </div>

    <!-- BOTTOM BAR (Now uses text-sm to match the rest of the footer) -->
    <div class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-col md:flex-row items-center justify-between gap-4">
      
      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        &copy; {currentYear} Pabitra Mohan Singh. All rights reserved.
      </p>
      
      <ul class="flex items-center gap-6 text-sm text-neutral-500 dark:text-neutral-400">
        {legalLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      
    </div>

  </div>
</footer>