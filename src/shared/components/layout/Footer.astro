---
import { SITE_CONFIG } from '@/shared/config/site';

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '/home';
const currentYear = new Date().getFullYear();

const FOOTER_PLATFORMS = ['GitHub', 'X'] as const;

const footerSocials = FOOTER_PLATFORMS
  .map((platform) => SITE_CONFIG.socialLinks.find((link) => link.platform === platform))
  .filter((link): link is NonNullable<typeof link> => link !== undefined);
---

<footer class="border-t border-neutral-200 dark:border-neutral-800 mt-16 py-6 text-center text-sm text-neutral-500 dark:text-neutral-400">
  <p>© {currentYear} {SITE_CONFIG.name}</p>

  {!isHomePage && (
    <div class="flex justify-center gap-4 mt-2">
      {footerSocials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-primary transition"
        >
          {social.platform === 'X' ? 'Twitter' : social.platform}
        </a>
      ))}
      <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-primary transition">
        Contact
      </a>
    </div>
  )}
</footer>