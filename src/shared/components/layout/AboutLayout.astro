---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '@/shared/interactive/ThemeToggle.astro';

export interface AboutLayoutProps {
  title: string;
  projectName: string;
  description?: string;
}

const { title, projectName, description } = Astro.props;
---

<BaseLayout {title} {description}>
  <Fragment slot="header">
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-neutral-950/80 border-b border-neutral-200 dark:border-neutral-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">

        <a
          href="/projects"
          class="inline-flex items-center gap-2 text-sm font-medium text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          All Projects
        </a>

        <h2 class="text-sm font-semibold text-neutral-900 dark:text-white truncate">
          {projectName}
        </h2>

        <ThemeToggle />
      </div>
    </header>
  </Fragment>

  <slot />
</BaseLayout>