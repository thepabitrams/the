---
export interface Props {
  lightImages?: string[];
  darkImages?: string[];
  class?: string;
}

const {
  lightImages = ['/icons/pabitra-avatar-suit-black.svg'],
  darkImages = ['/icons/pabitra-avatar-suit-white.svg'],
  class: className = 'w-full h-[400px]',
} = Astro.props;

const uniqueAnchorId = `particle-anchor-${Math.random().toString(36).substring(2, 9)}`;
---

<div id={uniqueAnchorId} class:list={["relative pointer-events-none", className]}>
  <canvas
    id={`canvas-${uniqueAnchorId}`}
    class="fixed inset-0 z-0 pointer-events-none"
    data-light-images={JSON.stringify(lightImages)}
    data-dark-images={JSON.stringify(darkImages)}
    data-anchor-id={uniqueAnchorId}
  ></canvas>
</div>

<script>
  import { ParticleEngine } from './engine';

  const canvases = document.querySelectorAll('canvas[data-anchor-id]');
  
  canvases.forEach((canvas) => {
    const htmlCanvas = canvas as HTMLCanvasElement;
    if (htmlCanvas.dataset.initialized) return;
    htmlCanvas.dataset.initialized = 'true';

    let engineInstance: ParticleEngine | null = null;
    
    const lightImages: string[] = JSON.parse(htmlCanvas.dataset.lightImages || '[]');
    const darkImages: string[] = JSON.parse(htmlCanvas.dataset.darkImages || '[]');
    const anchorId: string = htmlCanvas.dataset.anchorId || '';

    if (lightImages.length === 0 || darkImages.length === 0 || !anchorId) return;

    engineInstance = new ParticleEngine(htmlCanvas, lightImages, darkImages, anchorId);
    engineInstance.init();

    const destroy = () => {
      if (engineInstance) {
        engineInstance.destroy();
        engineInstance = null;
      }
    };

    document.addEventListener('astro:before-swap', destroy, { once: true });
    window.addEventListener('pagehide', destroy, { once: true });
  });
</script>