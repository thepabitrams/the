---
export interface Props {
  lightImages?: string[];
  darkImages?: string[];
  class?: string;
}

const {
  lightImages = ['/icons/pabitra-avatar-suit-black.svg'],
  darkImages = ['/icons/pabitra-avatar-suit-white.svg'],
  class: className = 'w-full h-[400px]',
} = Astro.props;

const uniqueAnchorId = `particle-anchor-${Math.random().toString(36).substring(2, 9)}`;
---

<div id={uniqueAnchorId} class:list={["relative pointer-events-none overflow-hidden", className]}>
  <canvas
    id={`canvas-local-${uniqueAnchorId}`}
    class="absolute inset-0 w-full h-full pointer-events-none transform-gpu will-change-transform"
    data-light-images={JSON.stringify(lightImages)}
    data-dark-images={JSON.stringify(darkImages)}
    data-anchor-id={uniqueAnchorId}
  ></canvas>
</div>

<canvas
  id={`canvas-blast-${uniqueAnchorId}`}
  class="fixed inset-0 w-screen h-screen pointer-events-none hidden z-9999 transform-gpu will-change-transform"
></canvas>

<script>
  import { ParticleEngine } from './engine';

  const localCanvases = document.querySelectorAll('canvas[id^="canvas-local-"]');
  
  localCanvases.forEach((localCanvas) => {
    const htmlLocalCanvas = localCanvas as HTMLCanvasElement;
    if (htmlLocalCanvas.dataset.initialized) return;
    htmlLocalCanvas.dataset.initialized = 'true';

    const anchorId: string = htmlLocalCanvas.dataset.anchorId || '';
    const blastCanvas = document.getElementById(`canvas-blast-${anchorId}`) as HTMLCanvasElement;

    let engineInstance: ParticleEngine | null = null;
    
    const lightImages: string[] = JSON.parse(htmlLocalCanvas.dataset.lightImages || '[]');
    const darkImages: string[] = JSON.parse(htmlLocalCanvas.dataset.darkImages || '[]');

    if (lightImages.length === 0 || darkImages.length === 0 || !anchorId || !blastCanvas) return;

    engineInstance = new ParticleEngine(htmlLocalCanvas, blastCanvas, lightImages, darkImages, anchorId);
    engineInstance.init();

    const destroy = () => {
      if (engineInstance) {
        engineInstance.destroy();
        engineInstance = null;
      }
    };

    document.addEventListener('astro:before-swap', destroy, { once: true });
    window.addEventListener('pagehide', destroy, { once: true });
  });
</script>