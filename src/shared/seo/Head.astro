---
import { SITE_CONFIGURATION } from '@/shared/config/site';

export interface HeadProps {
  title: string;
  description?: string;
  openGraphImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = SITE_CONFIGURATION.siteDescription,
  openGraphImage = SITE_CONFIGURATION.defaultOpenGraphImageUrl,
  canonicalUrl = SITE_CONFIGURATION.siteDomain,
} = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_CONFIGURATION.siteName,
  url: SITE_CONFIGURATION.siteDomain,
  image: SITE_CONFIGURATION.defaultOpenGraphImageUrl,
  jobTitle: SITE_CONFIGURATION.professionalJobTitle,
  sameAs: SITE_CONFIGURATION.socialMediaLinks.map((link) => link.profileUrl),
} as const;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_CONFIGURATION.siteName} />
<meta property="og:locale" content={SITE_CONFIGURATION.siteLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={openGraphImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={openGraphImage} />

<link rel="canonical" href={canonicalUrl} />

<link rel="icon" type="image/svg+xml" href="/icons/pabitra-avatar-black.svg" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href="/icons/pabitra-avatar-white.svg" media="(prefers-color-scheme: dark)" />

<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171717" />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />