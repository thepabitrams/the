<button
  id="theme-toggle"
  type="button"
  class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-all duration-300 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 dark:focus-visible:ring-offset-neutral-950 relative"
  aria-label="Toggle theme"
>
  <svg class="w-5 h-5 text-neutral-700 dark:hidden transition-transform duration-500 hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg class="w-5 h-5 text-neutral-300 hidden dark:block transition-transform duration-500 hover:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  const themeStorageKey: string = 'theme';
  const darkClassName: string = 'dark';
  const darkThemeValue: string = 'dark';
  const lightThemeValue: string = 'light';

  function applyThemePreference(isDarkModeRequested: boolean): void {
    const documentRootElement: HTMLElement = document.documentElement;

    if (isDarkModeRequested) {
      documentRootElement.classList.add(darkClassName);
      localStorage.setItem(themeStorageKey, darkThemeValue);
      return;
    }

    documentRootElement.classList.remove(darkClassName);
    localStorage.setItem(themeStorageKey, lightThemeValue);
  }

  function initializeThemeToggleListener(): void {
    const themeToggleButton: HTMLElement | null = document.getElementById('theme-toggle');

    if (!(themeToggleButton instanceof HTMLButtonElement)) {
      return;
    }

    themeToggleButton.addEventListener('click', (): void => {
      const isDarkModeCurrentlyActive: boolean = document.documentElement.classList.contains(darkClassName);
      applyThemePreference(!isDarkModeCurrentlyActive);
    });
  }

  initializeThemeToggleListener();
</script>