---
import { SponsorLayout } from '@/layouts';
import Avatar from './ui/Avatar.astro';
import Featured from './ui/Featured.astro';
import More from './ui/More.astro';
---

<SponsorLayout 
  title="Sponsor My Work — Pabitra Mohan Singh" 
  description="Sponsor my open-source work via GitHub, Buy Me a Coffee, or UPI."
>
  <section class="w-full max-w-6xl mx-auto px-6 pt-8 pb-16 md:pt-12 md:pb-24">
    
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-8 w-full">
      
      <div class="w-full lg:w-[45%] flex justify-center lg:justify-start animate-on-load animate-slide-left delay-1">
        <Avatar class="w-full max-w-[350px] md:max-w-[450px] h-[350px] md:h-[450px] lg:h-[550px]" />
      </div>

      <div class="w-full lg:w-[55%] flex justify-center lg:justify-end animate-on-load animate-slide-right delay-2">
        <Featured />
      </div>

    </div>

    <div class="mt-12 animate-on-load animate-slide-bottom delay-3 w-full">
      <More />
    </div>

  </section>
</SponsorLayout>