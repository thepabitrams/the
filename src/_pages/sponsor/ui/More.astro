---
import { LinkCard } from '@/shared/components/card';

interface SponsorLink {
  readonly href: string;
  readonly title: string;
  readonly description: string;
  readonly iconSvg: string;
  readonly iconBackgroundColorClass: string;
  readonly iconTextColorClass: string;
}

const secondarySponsorLinks: readonly SponsorLink[] = [
  {
    href: 'https://ko-fi.com/thepabitrams',
    title: 'Ko-fi',
    description: '0% fee tips',
    iconSvg: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>`,
    iconBackgroundColorClass: 'bg-red-50 dark:bg-red-900/20',
    iconTextColorClass: 'text-red-500'
  },
  {
    href: 'https://patreon.com/thepabitrams',
    title: 'Patreon',
    description: 'Recurring membership',
    iconSvg: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 100-18 9 9 0 000 18z" /></svg>`,
    iconBackgroundColorClass: 'bg-orange-50 dark:bg-orange-900/20',
    iconTextColorClass: 'text-orange-500'
  },
  {
    href: 'https://opencollective.com/thepabitrams',
    title: 'Open Collective',
    description: 'Transparent funds',
    iconSvg: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    iconBackgroundColorClass: 'bg-indigo-50 dark:bg-indigo-900/20',
    iconTextColorClass: 'text-indigo-500'
  },
  {
    href: 'https://polar.sh/thepabitrams',
    title: 'Polar.sh',
    description: 'Digital products',
    iconSvg: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    iconBackgroundColorClass: 'bg-cyan-50 dark:bg-cyan-900/20',
    iconTextColorClass: 'text-cyan-500'
  },
  {
    href: 'https://liberapay.com/thepabitrams',
    title: 'Liberapay',
    description: 'Recurring donation',
    iconSvg: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
    iconBackgroundColorClass: 'bg-yellow-50 dark:bg-yellow-900/20',
    iconTextColorClass: 'text-yellow-600'
  },
  {
    href: 'https://buymeachai.com/thepabitrams',
    title: 'Buy Me a Chai',
    description: 'Support (India)',
    iconSvg: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
    iconBackgroundColorClass: 'bg-amber-100 dark:bg-amber-900/20',
    iconTextColorClass: 'text-amber-700 dark:text-amber-500'
  }
];
---

<div class="w-full">
  
  <div class="relative flex items-center justify-center mb-8">
    <div class="absolute inset-0 flex items-center" aria-hidden="true">
      <div class="w-full border-t border-neutral-200 dark:border-neutral-800"></div>
    </div>
    <div class="relative bg-neutral-50 dark:bg-neutral-950 px-6">
      <span class="text-xs font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">
        More Ways to Support
      </span>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
    {secondarySponsorLinks.map((link) => (
      <LinkCard 
        href={link.href}
        title={link.title}
        description={link.description}
        iconSvg={link.iconSvg}
        iconBackgroundColorClass={link.iconBackgroundColorClass}
        iconTextColorClass={link.iconTextColorClass}
      />
    ))}
  </div>
  
</div>