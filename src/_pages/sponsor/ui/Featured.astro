---
import { LinkCard } from '@/shared/components/card';
import { sponsor } from '@/shared/config/site';

interface SponsorLink {
  readonly sponsorName: string;
  readonly sponsorDescription: string;
  readonly destinationUrl: string;
  readonly iconSvgString: string;
  readonly iconContainerBackgroundClass: string;
  readonly iconForegroundColorClass: string;
}

const featuredSponsorLinks: readonly SponsorLink[] = [
  {
    sponsorName: 'GitHub Sponsors',
    sponsorDescription: 'Recurring support',
    destinationUrl: sponsor.github,
    iconSvgString: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.62.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>`,
    iconContainerBackgroundClass: 'bg-neutral-100 dark:bg-neutral-800',
    iconForegroundColorClass: 'text-neutral-900 dark:text-white'
  },
  {
    sponsorName: 'Buy Me a Coffee',
    sponsorDescription: 'One-off tip',
    destinationUrl: sponsor.buyMeACoffee,
    iconSvgString: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.11 0 2-.89 2-2V5c0-1.11-.89-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z" /></svg>`,
    iconContainerBackgroundClass: 'bg-[#FFDD00]/10 dark:bg-[#FFDD00]/20',
    iconForegroundColorClass: 'text-[#FFDD00]'
  },
  {
    sponsorName: 'Razorpay (UPI)',
    sponsorDescription: 'Direct support (India)',
    destinationUrl: sponsor.razorpay,
    iconSvgString: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    iconContainerBackgroundClass: 'bg-blue-50 dark:bg-blue-900/20',
    iconForegroundColorClass: 'text-blue-600 dark:text-blue-400'
  }
];
---

<div class="w-full max-w-2xl flex flex-col gap-6">
  
  <div class="text-center lg:text-left">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white mb-4">
      Sponsor My Work
    </h1>
    <p class="text-base text-neutral-500 dark:text-neutral-400 leading-relaxed">
      If my open-source code or writing saved you time, consider supporting the servers. Every bit helps me keep building.
    </p>
  </div>

  <div class="flex flex-col gap-3 w-full">
    {featuredSponsorLinks.map((sponsorLinkData) => (
      <LinkCard 
        href={sponsorLinkData.destinationUrl}
        title={sponsorLinkData.sponsorName}
        description={sponsorLinkData.sponsorDescription}
        iconSvg={sponsorLinkData.iconSvgString}
        iconBackgroundColorClass={sponsorLinkData.iconContainerBackgroundClass}
        iconTextColorClass={sponsorLinkData.iconForegroundColorClass}
      />
    ))}
  </div>

</div>