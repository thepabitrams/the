---
import { ProjectLayout } from '@/layouts/';
import Grid from './Grid.astro';
import { getCollection } from 'astro:content';
import type { ProjectEntry } from '@/shared/types/project-entry';

const projects = await getCollection('projects');

const entries: ProjectEntry[] = projects.map((entry) => ({
  slug: entry.id.replace(/\/card$/, ''),
  data: entry.data,
  body: entry.body || '',
}));
---

<ProjectLayout title="Projects – Pabitra Mohan Singh">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-12 md:pt-10 md:pb-16 relative">

    <div class="animate-on-load animate-slide-left delay-1 mb-8">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight text-neutral-900 dark:text-white">
        Projects
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl">
        A selection of projects that demonstrate my skills, passion and experience.
      </p>
    </div>

    <div class="animate-on-load animate-slide-bottom delay-2">
      <Grid entries={entries} />
    </div>

    {entries.length === 0 && (
      <p class="text-center text-red-500 mt-10">⚠️ No projects found. Check your content folder.</p>
    )}

  </section>
</ProjectLayout>