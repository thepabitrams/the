---
import BaseLayout from '@/shared/components/layout/BaseLayout.astro';
import Grid from './Grid.astro';
import Modal from './Modal.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

const entries = projects.map((entry) => ({
  slug: entry.id,
  data: entry.data,
  body: entry.body || '',
}));
---

<BaseLayout title="Projects – Pabitra Mohan Singh">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20 relative">
    <div class="animate-on-load animate-slide-left delay-1 mb-10">
      <h1 class="text-4xl md:text-5xl font-black tracking-tight text-neutral-900 dark:text-white">
        Projects
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 mt-2 max-w-2xl">
        A selection of projects that demonstrate my skills, passion and experience.
      </p>
    </div>

    <Grid entries={entries} />
    
    {entries.length === 0 && (
      <p class="text-center text-red-500 mt-10">⚠️ No projects found. Check your content folder.</p>
    )}

    <Modal entries={entries} />
  </section>
</BaseLayout>