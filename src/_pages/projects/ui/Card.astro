---
import { resolveBadges } from '@/shared/components/ui/tech';
import Preview from './Preview.astro';
import type { ProjectEntry } from '@/shared/types/project-entry';

export interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const projectData = project.data;
const projectSlug = project.slug;
const techStack = projectData.techStack ?? [];
const badges = resolveBadges(techStack);
const preview = projectData.preview ?? [];
---

<div
  class="project-card-item group/card bg-white dark:bg-neutral-900 rounded-2xl
         border border-neutral-200 dark:border-white/10
         hover:border-neutral-300 dark:hover:border-white/25
         transition-all duration-300
         hover:shadow-xl hover:shadow-neutral-200/50
         dark:hover:shadow-xl dark:hover:shadow-white/10
         overflow-hidden flex flex-col h-full"
  data-title={projectData.title}
  data-desc={projectData.description}
  data-tags={techStack.join(' ')}
>
  <div class="aspect-4/3 bg-neutral-100 dark:bg-neutral-800 relative overflow-hidden flex items-center justify-center">
    {preview.length > 0 ? (
      <div class="w-full">
        <Preview slides={preview} />
      </div>
    ) : projectData.image ? (
      <img
        src={projectData.image}
        alt={projectData.title}
        class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-105"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center text-neutral-400 dark:text-neutral-600 text-sm">
        Project Preview
      </div>
    )}
  </div>

  <div class="p-6 md:p-8 flex-1 flex flex-col">
    <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white mb-2">
      {projectData.title}
    </h2>

    <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-5">
      {projectData.description}
    </p>

    {badges.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {badges.map((badge) => (
          <badge.Component {...badge.props} />
        ))}
      </div>
    )}

    <div class="flex flex-wrap items-center gap-3 mt-auto">
      {projectData.liveUrl && (
        <a
          href={projectData.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group/link inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary/80 transition-colors"
        >
          Live Demo
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
            fill="none" stroke="currentColor" stroke-width="2.25"
            viewBox="0 0 24 24" aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      )}

      {projectData.githubUrl && (
        <a
          href={projectData.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group/link inline-flex items-center gap-1 text-sm font-medium text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          Source
          <svg
            class="w-3.5 h-3.5 transition-transform duration-200 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5"
            fill="none" stroke="currentColor" stroke-width="2.25"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8" />
          </svg>
        </a>
      )}

      <a
        href={`/projects/${projectSlug}`}
        class="group/link ml-auto inline-flex items-center gap-1 text-sm font-medium text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        About
        <svg
          class="w-3.5 h-3.5 transition-transform duration-200 group-hover/link:translate-x-0.5"
          fill="none" stroke="currentColor" stroke-width="2.25"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-6-6m6 6l-6 6" />
        </svg>
      </a>
    </div>
  </div>
</div>