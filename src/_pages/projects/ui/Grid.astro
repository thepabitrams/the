---
import Card from './Card.astro';
import FeaturedCard from './FeaturedCard.astro';
import { PROJECT_RENDER_ORDER } from '@/shared/config/project-order';
import type { ProjectEntry } from '@/shared/types/project-entry';

export interface Props {
  entries: ProjectEntry[];
}

const { entries } = Astro.props;

const UNRANKED_POSITION = Number.MAX_SAFE_INTEGER;

const rankBySlug = new Map<string, number>(
  PROJECT_RENDER_ORDER.map((slug, position) => [slug, position])
);

const resolveRank = (slug: string): number =>
  rankBySlug.get(slug) ?? UNRANKED_POSITION;

const rankedEntries = [...entries].sort((firstEntry, secondEntry) => {
  const firstRank = resolveRank(firstEntry.slug);
  const secondRank = resolveRank(secondEntry.slug);
  return firstRank !== secondRank
    ? firstRank - secondRank
    : firstEntry.slug.localeCompare(secondEntry.slug);
});

const featuredEntries = rankedEntries.filter(
  (entry) => entry.data.featured === true
);

const standardEntries = rankedEntries.filter(
  (entry) => entry.data.featured !== true
);
---

<div class="pb-0 mb-8 border-b border-neutral-200 dark:border-white/10"></div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="project-grid">

  {featuredEntries.map((entry) => (
    <FeaturedCard project={entry} />
  ))}

  {standardEntries.map((entry) => (
    <Card project={entry} />
  ))}

</div>