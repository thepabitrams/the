---
import type { Project } from '../../types/project';

export interface Props {
  entries: Array<{
    slug: string;
    data: Project;
    body?: string;
  }>;
}
const { entries } = Astro.props;

const aboutModules = import.meta.glob('../../content/projects/*/_about.mdx', {
  eager: true,
});

const aboutMap = new Map<string, any>();
for (const [path, aboutModule] of Object.entries(aboutModules)) {
  const slug = path.split('/').slice(-2, -1)[0];
  aboutMap.set(slug, aboutModule);
}
---

{entries.map((entry) => {
  const projectSlug = entry.slug;
  const projectData = entry.data;
  const aboutModule = aboutMap.get(projectSlug);
  const AboutContent = aboutModule?.Content;

  return (
    <>
      <input
        type="checkbox"
        id={`about-${projectSlug}`}
        class="hidden about-toggle"
      />

      <div class="about-modal fixed inset-0 z-50 flex pointer-events-none opacity-0 transition-opacity duration-300">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

        <div class="relative bg-white dark:bg-neutral-900 w-full h-full overflow-hidden about-content">

          <div class="max-w-6xl mx-auto w-full h-full flex flex-col px-4 sm:px-6">

            <div class="flex items-center justify-between py-4 md:py-6 border-b border-neutral-200 dark:border-neutral-700 sticky top-0 z-10 bg-white dark:bg-neutral-900">
              <h2 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white truncate pr-4">
                {projectData.title}
              </h2>

              <label
                for={`about-${projectSlug}`}
                class="p-1.5 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer flex-shrink-0"
                aria-label="Close"
              >
                <svg class="w-5 h-5 md:w-6 md:h-6 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </label>
            </div>

            <div class="py-6 md:py-8 overflow-y-auto flex-1">
              {AboutContent ? (
                <div class="prose prose-neutral dark:prose-invert max-w-none">
                  <AboutContent />
                </div>
              ) : (
                <p class="text-neutral-500 dark:text-neutral-400">No about content available.</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </>
  );
})}

<style>
  html:has(.about-toggle:checked) {
    overflow: hidden !important;
  }
  body:has(.about-toggle:checked) {
    overflow: hidden !important;
  }

  .about-modal {
    transition: opacity 0.25s ease, pointer-events 0s ease 0.3s;
  }
  .about-toggle:checked + .about-modal {
    opacity: 1 !important;
    pointer-events: auto !important;
    transition: opacity 0.25s ease, pointer-events 0s ease 0s;
  }

  .about-content {
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.2s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .about-toggle:checked + .about-modal .about-content {
    opacity: 1;
    transform: scale(1);
  }
</style>