---
import { HomeLayout } from '@/layouts/';
import Bio from './ui/Bio.astro';
import Profile from './ui/Profile.astro';
import WhatIDo from './ui/WhatIDo.astro';
import Socials from './ui/Socials.astro';
---

<HomeLayout 
  title="Pabitra Mohan Singh – Software Engineer" 
  description="Building clean, scalable, and user-focused applications"
>
  <section class="py-16 md:py-24 max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-16">
      <Bio />
      <Profile />
    </div>
    
    <div class="mt-12 flex justify-center md:justify-start animate-on-load animate-slide-left delay-3">
      <Socials />
    </div>
    
    <div class="mt-16">
      <WhatIDo />
    </div>
  </section>
</HomeLayout>