---
import { SITE_CONFIG } from '@/shared/config/site';

export interface BioProps {
  introduction?: string;
  mission?: string;
}

const {
  introduction = 'A Computer Science student passionate about software engineering and artificial intelligence.',
  mission = 'I enjoy building clean, scalable, and user-focused applications while continuously learning and improving as a developer.',
}: BioProps = Astro.props;
---

<div
  class="flex-1 text-center md:text-left space-y-4 animate-on-load animate-slide-left delay-1"
>
  <h1
    class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-neutral-900 dark:text-white"
  >
    {SITE_CONFIG.name}
  </h1>

  <div class="space-y-3 max-w-2xl">
    <p
      class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed"
    >
      {introduction}
    </p>
    <p
      class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed"
    >
      {mission}
    </p>
  </div>
</div>