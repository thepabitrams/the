---
import { social, email } from '@/shared/config/site';
import { GitHub, LinkedIn, X, YouTube, Instagram, Gmail } from '@/shared/components/ui/icons';
import LinkButton from '@/shared/components/ui/LinkButton.astro';

const iconMapping = {
  github: GitHub,
  linkedin: LinkedIn,
  x: X,
  youtube: YouTube,
  instagram: Instagram,
} as const;
---

<div class="flex flex-wrap items-center gap-5">
  {Object.entries(social).map(([platformName, profileUrl]) => {
    const IconComponent = iconMapping[platformName as keyof typeof iconMapping];
    if (!IconComponent) return null;

    const displayName = platformName.charAt(0).toUpperCase() + platformName.slice(1);

    return (
      <a
        href={profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center transition-transform duration-300 ease-out hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 rounded"
        aria-label={displayName}
        title={displayName}
      >
        <IconComponent />
      </a>
    );
  })}

  <LinkButton href={`mailto:${email.general}`} label="Contact Me">
    <Gmail slot="icon" class="w-4 h-4" />
  </LinkButton>
</div>