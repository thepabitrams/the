---
import Base from '@/layouts/Base.astro';
import Avatar from './ui/Avatar.astro';
import { social } from '@/shared/config/site';

const footerSocialLinks = [
  { label: 'GitHub', href: social.github },
  { label: 'X', href: social.x },
  { label: 'LinkedIn', href: social.linkedin },
  { label: 'Instagram', href: social.instagram },
];
---

<Base 
  title="404 Page Not Found - Pabitra Mohan Singh - Software Engineer" 
  description="Oops! The page you are looking for doesn't exist or has been moved. Return to Pabitra Mohan Singh's homepage to explore projects and open-source work."
  noindex={true}
>
  <div class="min-h-screen flex flex-col items-center justify-center py-20 px-6 bg-white dark:bg-black transition-colors duration-300">
    
    <div class="flex flex-col items-center justify-center text-center max-w-xl mx-auto w-full">
      
      <h1 class="text-8xl md:text-9xl font-black tracking-tighter mb-2 text-neutral-900 dark:text-white">
        404
      </h1>
      
      <h2 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white mb-12">
        Page Not Found
      </h2>

      <div class="mb-10">
        <Avatar className="w-40 h-40 md:w-48 md:h-48" />
      </div>

      <div class="min-h-12 mb-10 flex items-center justify-center w-full px-4">
        <span 
          id="typewriterElement" 
          class="text-sm md:text-lg font-mono text-neutral-500 dark:text-neutral-400 text-center leading-relaxed"
        ></span>
      </div>

      <a 
        href="/" 
        class="text-lg md:text-xl font-bold tracking-wide text-neutral-900 dark:text-white transition-colors duration-300 hover:text-blue-600 dark:hover:text-blue-400 underline underline-offset-8 decoration-2 decoration-neutral-200 dark:decoration-neutral-800 hover:decoration-blue-600 dark:hover:decoration-blue-400 mb-8"
      >
        Pabitra Mohan Singh
      </a>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        {footerSocialLinks.map((socialLink) => (
          <a 
            href={socialLink.href} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-sm md:text-base font-medium text-neutral-400 dark:text-neutral-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
          >
            {socialLink.label}
          </a>
        ))}
      </div>

    </div>

  </div>
</Base>

<script>
  const typewriterElement = document.getElementById('typewriterElement') as HTMLSpanElement;
  
  if (typewriterElement) {
    const typewriterMessages = [
      "Are you still there?",
      "The page you requested could not be found.",
      "Searching for the missing route...",
      "Looks like this link is broken.",
      "This URL does not exist.",
      "Nothing to see here.",
      "Let's get you back on track.",
      "The page has been moved or deleted.",
      "404: The requested resource is unavailable.",
      "Oops! We couldn't find that page.",
      "Looks like you took a wrong turn.",
      "This route is currently missing.",
      "We searched everywhere, but it's not here.",
      "The link may be outdated.",
      "Please check the URL and try again.",
      "You've reached a dead end.",
      "The server could not find the requested page.",
      "This page is no longer available.",
      "Let's head back to the homepage.",
      "Error 404: Page not found."
    ];

    let currentMessageIndex = 0;
    let currentCharacterIndex = 0;
    let isDeletingCharacter = false;

    function animateTypewriterText() {
      const currentMessage = typewriterMessages[currentMessageIndex];
      
      if (isDeletingCharacter) {
        typewriterElement.textContent = currentMessage.substring(0, currentCharacterIndex - 1);
        currentCharacterIndex--;
      } else {
        typewriterElement.textContent = currentMessage.substring(0, currentCharacterIndex + 1);
        currentCharacterIndex++;
      }

      let typingDelayMilliseconds = isDeletingCharacter ? 40 : 80;

      if (!isDeletingCharacter && currentCharacterIndex === currentMessage.length) {
        typingDelayMilliseconds = 2000;
        isDeletingCharacter = true;
      } else if (isDeletingCharacter && currentCharacterIndex === 0) {
        isDeletingCharacter = false;
        currentMessageIndex = (currentMessageIndex + 1) % typewriterMessages.length;
        typingDelayMilliseconds = 500;
      }

      setTimeout(animateTypewriterText, typingDelayMilliseconds);
    }

    setTimeout(animateTypewriterText, 1000);
  }
</script>